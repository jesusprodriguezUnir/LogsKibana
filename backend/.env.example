# ─── Backend LogsKibana — variables de entorno ────────────────────────────────
# Copia este fichero a `.env` y ajusta los valores. Todas son opcionales:
# entre paréntesis se indica el valor por defecto.

# Host y puerto del backend para local
HOST=127.0.0.1
PORT=8000

# API / seguridad ──────────────────────────────────────────────────────────────
# Orígenes permitidos por CORS, separados por comas (http://localhost:5173)
CORS_ORIGINS=http://localhost:5173
# Si se define, /api/publish exige la cabecera X-API-Key con este valor (sin auth)
# API_KEY=

# Upload ────────────────────────────────────────────────────────────────────────
# Tamaño máximo del CSV subido, en MB (50)
MAX_UPLOAD_MB=50

# Session store ──────────────────────────────────────────────────────────────────
# Nº máximo de sesiones en memoria antes de evacuar por LRU (100)
SESSION_MAX=100
# Tiempo de vida de cada sesión en segundos (3600)
SESSION_TTL_SECONDS=3600

# RabbitMQ ───────────────────────────────────────────────────────────────────────
# Activa/desactiva la integración (true). Admite 0/false/off/no como desactivado.
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://devuser:devpassword@127.0.0.1:5672/
RABBITMQ_RETRIES=5
RABBITMQ_RETRY_DELAY=5
